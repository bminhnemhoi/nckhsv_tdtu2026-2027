\begin{figure}[H]\centering
\includegraphics[width=0.94\textwidth]{figs/fig2_dai_loc.pdf}
\caption{Khảo sát tám dải thông, mỗi dải là một lần chạy tách theo bản ghi đầy đủ. Chênh lệch giữa dải
tốt nhất và kém nhất là 18,89 điểm F1 --- lớn hơn toàn bộ khác biệt giữa 16 kiến trúc học sâu.}
\label{fig:band}
\end{figure}

Ba nguồn y văn độc lập đọc từ toàn văn ủng hộ hướng này: Behar và cộng sự 2014 tìm kiếm lưới ra
20--95\,Hz; Clifford và cộng sự 2014 ghi nhận cắt thông cao ở 10\,Hz cải thiện kết quả do loại bỏ sóng P
và T của mẹ; Xu và cộng sự 2026 dùng đúng 10--60\,Hz.

\begin{canhbao}[title={Nói rõ: dải 10--60\,Hz KHÔNG phải phát hiện của nhóm}]
Dải thắng cuộc là dải nhóm \textbf{lấy từ y văn}: \texttt{survey/facts\_verified.json} ghi
\texttt{"nguon\_y\_van": "Xu 2026"} cho chính dòng 10--60\,Hz. Behar 2014 cũng đã tìm kiếm lưới dải thông
như một phần phương pháp, và Andreotti và cộng sự 2016 đã chứng minh rằng lựa chọn tiền xử lý
\textbf{đảo thứ hạng} các thuật toán trích fECG.

Vì vậy thông điệp \textit{``cả một lĩnh vực đang tối ưu sai tầng''} \textbf{không đứng vững} và đã bị gỡ
khỏi đề cương. Đóng góp còn lại của nhóm ở tầng này là \textbf{định lượng}: đo mức tăng trong cùng một
thí nghiệm có kiểm soát, cạnh hai tầng còn lại, trên dữ liệu thật --- điều mà Andreotti 2016 làm định
tính trên dữ liệu tổng hợp.
\end{canhbao}

Một chi tiết nhóm muốn nêu vì nó phản trực giác: dải có \textbf{tương phản cao nhất} (20--95\,Hz, tỉ số
RMS 1,94) lại cho F1 gần \textbf{thấp nhất} (77,39). Tương phản không phải hàm mục tiêu.

\subsection{Quy tắc chọn kênh mù nhãn}
\label{sec:chonkenh}

Đây là kết quả nhóm coi là quan trọng nhất trong đợt thực nghiệm vừa rồi, và nó xuất phát từ một
lỗi liêm chính mà nhóm tự phát hiện.

\begin{canhbao}[title={Lỗi nhóm tự phát hiện và đã sửa}]
Con số ``77,52'' mà bản đề cương trước báo cáo cho thí nghiệm xuyên bộ dữ liệu là kết quả
\textbf{chọn kênh tốt nhất bằng nhãn thật}. Đó là chọn kênh kiểu ``thần thánh'' (oracle), không dùng
được trong thực tế và không được phép báo cáo như hiệu năng hệ thống.
\end{canhbao}

Nhóm đã thay bằng quy tắc chọn kênh \textbf{mù nhãn} theo Power-MF: chọn kênh có đỉnh mật độ phổ công
suất lớn nhất trong dải nhịp tim thai 1,8--3,0\,Hz (tương ứng 108--180 nhịp/phút), tính trên đường bao
năng lượng của tín hiệu dư. Quy tắc này không dùng nhãn và có thể đăng ký trước.

\begin{canhbao}[title={Bảng này đã đổi hoàn toàn trong bản 3.3 --- và nó lật một kết luận cũ}]
Bản 3.2 báo cáo cột CinC 2013 trên \textbf{mẫu 10 bản ghi} và kết luận: \textit{``quy tắc mù nhãn sụp đổ
ngoài miền (59,15 so với 77,34 của quy tắc cố định đơn giản hơn)''}. Trên \textbf{toàn bộ 75 bản ghi}
kết luận đó \textbf{đảo ngược}: quy tắc mù nhãn đạt 71,21 còn quy tắc kênh 0 cố định chỉ đạt 58,72.
Chính \textbf{quy tắc kênh 0} mới là thứ sụp, và nó sụp vì nó được chọn hậu kiểm trên đúng 10 bản ghi đó
(\S\ref{sec:cinc75}).
\end{canhbao}

\begin{table}[H]\centering\small
\caption{So sánh bốn quy tắc chọn kênh, mô hình 5 ca. Cột CinC 2013 nay đo trên \textbf{toàn bộ 75 bản
ghi} set-a; cột trong ngoặc là con số cũ trên mẫu 10 bản ghi, giữ lại để thấy mức lệch.}
\label{tab:chonkenh}
\begin{tabular}{@{}L{5.4cm} C{2.8cm} C{3.0cm} C{2.8cm}@{}}
\toprule
\textbf{Quy tắc chọn kênh} & \textbf{ADFECGDB} & \textbf{CinC 2013, 75 bản ghi} &
\textbf{(mẫu 10 cũ)} \\
\midrule
Mù nhãn theo mật độ phổ công suất & \tot{99,21} & \tot{71,21} & \textit{(59,15)} \\
Kênh cố định (kênh đầu tiên) & 98,09 & \xau{58,72} & \textit{(77,34)} \\
Bản đồ đạo trình do giao thức quy định & 99,18 & --- & --- \\
Oracle, dùng nhãn thật & \textit{99,21} & \textit{78,21} & \textit{(77,59)} \\
Trung bình trên cả 4 kênh & 97,45 & 64,78 & \textit{(61,96)} \\
\bottomrule
\end{tabular}
\end{table}

\begin{ghichu}[title={Phát hiện khoa học, phát biểu lại cho đúng}]
Quy tắc chọn kênh mù nhãn đạt \textbf{đúng bằng oracle} khi ở trong miền (99,21 so với 99,21), và
\textbf{vẫn là quy tắc mù nhãn tốt nhất} khi ra ngoài miền (71,21 so với 58,72 của kênh cố định). Nó
\textbf{không} sụp đổ.

Điều thật sự sụp là \textbf{khoảng cách đến oracle}: trong miền quy tắc PSD kém oracle
\textbf{0,02--1,90 điểm} (PhysioNet 0,02; Silesia B2 0,66; Silesia B1 1,90); ngoài miền nó kém oracle
\textbf{7,00 điểm} (71,21 so với 78,21), và với mô hình 22 ca là \textbf{7,47 điểm}. Quy tắc chỉ chọn
trúng kênh oracle ở 22/75 bản ghi.

Nói cách khác: một chỉ số chất lượng dựa trên phổ \textbf{mất phần lớn giá trị} đúng ở nơi ta cần nó
nhất. \textbf{Đây vẫn là động cơ đã đo được cho đóng góp C3} --- nhưng ở mức ``mất 7 điểm'', không phải
``sụp đổ hoàn toàn'' như bản 3.2 viết.
\end{ghichu}

\subsection{Kết quả cuối trên ADFECGDB}

\begin{table}[H]\centering\small
