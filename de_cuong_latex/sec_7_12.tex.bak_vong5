\end{tabular}
\end{table}

\subsection{Kế hoạch công bố}

\begin{enumerate}[leftmargin=1.8em,itemsep=4pt]
\item \textbf{Hội nghị Computing in Cardiology} (4 trang, hạn tháng 4): trình bày C2, phân rã đóng góp
ba tầng. Đây là kết quả đã có, viết được ngay sau Phase P1.
\item \textbf{Tạp chí Q1} --- \textit{Physiological Measurement} hoặc \textit{Biomedical Signal Processing
and Control} hoặc \textit{IEEE JBHI}: bài đầy đủ gồm C1, C2, C3.
\item \textbf{Báo cáo Euréka}: bản tiếng Việt, nhấn mạnh sản phẩm chạy được và giá trị ứng dụng.
\end{enumerate}

\begin{ghichu}[title={Vì sao đề tài có cửa Q1}]
Bốn lý do, xếp theo độ vững --- và mỗi lý do kèm ranh giới của nó:
\begin{enumerate}[leftmargin=1.5em,itemsep=3pt]
\item \textbf{Phân rã ba tầng trong một thí nghiệm duy nhất} (C2), trên dữ liệu thật, ở mức chủ thể.
Chưa ai làm điều này trong fECG. \textit{Ranh giới:} luận điểm định tính đã có từ Andreotti 2016; nhóm
thêm con số, không thêm ý tưởng.
\item \textbf{Liêm chính phương pháp có thể kiểm tra được.} Bản 3.3 tự rút bốn phát biểu của bản 3.2,
mỗi lần kèm con số đúng và mã chạy lại được. Một phản biện Q1 khó tìm ra lỗi mà nhóm chưa tự nêu.
\textit{Ranh giới:} điều này làm bài báo đáng tin, không làm nó mới.
\item \textbf{Một đối chuẩn công bằng thật, và một câu hỏi đo được} (C1): Power-MF chạy lại trên cùng
máy, cùng bộ chấm, ở \textbf{cả hai cấu hình đạo trình}. Điều đó cho phép nhóm hỏi một câu mà chưa ai
hỏi bằng số trong fECG: \textit{một mạng đơn kênh lấy lại được bao nhiêu phần lợi ích của tách nguồn đa
kênh?} Đáp số: tách nguồn đa kênh đáng 12,12 điểm F1 cho chính Power-MF, mạng đơn kênh lấy lại 10,85
điểm, tức \textbf{89,5\,\%} (\S\ref{sec:luande}). \textit{Ranh giới:} so với Power-MF đa kênh đầy đủ thì
đây là \textbf{hoà}, không phải thắng --- và tỉ số 89,5\,\% chưa có khoảng tin cậy.
\item \textbf{Một cổng từ chối đã đo được} cho C3: $+7{,}49$ điểm F1 ở độ phủ 80\% ngoài miền, kèm một
kết quả phủ định có kiểm soát về TDA. \textit{Ranh giới:} cơ chế không mới (Andreotti 2017), và AUROC
trong bản ghi chỉ 0,721.
\end{enumerate}
Và kể cả khi C3 thất bại, giả thuyết H0 đã dự phòng: đối chuẩn cộng phân rã cộng kết quả phủ định có
kiểm định vẫn là một bài báo hoàn chỉnh.

\textbf{Điều nhóm KHÔNG còn nói:} ``front-end quan trọng hơn kiến trúc 27 lần'' --- tỉ số đó lấy từ
$0{,}41$ điểm, một con số nay đã được thay bằng khoảng $-2{,}95$ đến $+0{,}73$ điểm mà nghiên cứu không
đủ lực để thu hẹp. Tỉ số ``bao nhiêu lần'' không tính được từ dữ liệu này.
\end{ghichu}

\clearpage

