\section{Tài liệu tham khảo}

Ba mươi công trình dưới đây nhóm đã đọc \textbf{toàn văn}, không dừng ở tóm tắt. Bản PDF được lưu trong
thư mục \texttt{papers/} kèm tệp \texttt{papers\_records.json} ghi nguồn tải và mức truy cập của từng bài.

\input{tables/danhmuc.tex}

\subsection*{Tài liệu bổ sung phát hiện trong quá trình rà soát}

\begin{enumerate}[leftmargin=1.6em,itemsep=2pt,label={[\arabic*]},start=31]
\item Jaeger KM, Nissen M, Rahm S, Titzmann A, Fasching PA, Beilner J, Eskofier BM, Leutheuser H.
Power-MF: robust fetal QRS detection from non-invasive fetal electrocardiogram recordings.
\textit{Physiological Measurement} 45(5):055009, 2024. DOI 10.1088/1361-6579/ad4952.
Mã nguồn: \texttt{github.com/mad-lab-fau/fecg-benchmarking}. \textbf{Đã chạy lại} (\S\ref{sec:powermf}).
\item Andreotti F, Behar J, Zaunseder S, Oster J, Clifford GD. An open-source framework for stress-testing
non-invasive foetal ECG extraction algorithms. \textit{Physiological Measurement} 37(5):627--648, 2016.
DOI 10.1088/0967-3334/37/5/627. \textbf{Tiền lệ của luận điểm ``tiền xử lý đảo thứ hạng thuật toán''.}
\item Andreotti F, Zaunseder S, Malberg H, và cộng sự. Robust fetal ECG quality assessment.
\textit{IEEE Transactions on Biomedical Engineering}, 2017. DOI 10.1109/TBME.2017.2675543.
\textbf{Tiền lệ của cổng từ chối / fSQI cho fECG.}
\item Fotiadou E, van Sloun RJG, van Laar JOEH, Vullings R. A dilated inception CNN-LSTM network for fetal
heart rate estimation. \textit{Physiological Measurement} 42(4):045007, 2021.
DOI 10.1088/1361-6579/abf7db. \textbf{Tiền lệ của việc quét lịch giãn nở / trường tiếp nhận trong fECG.}
\item Zahid MU, Kiranyaz S, Ince T, và cộng sự. Robust R-peak detection in low-quality Holter ECGs using
1D convolutional neural network. \textit{IEEE Transactions on Biomedical Engineering} 69(1):119--128, 2022.
DOI 10.1109/TBME.2021.3088218 (arXiv:2101.01666). \textbf{Tiền lệ của đầu ra theo từng mẫu cho dò đỉnh R.}
\item Huang và cộng sự. TCGAN: Temporal Convolutional GAN for fetal ECG extraction using single-channel
abdominal ECG. \textit{IEEE Journal of Biomedical and Health Informatics}, 2025.
DOI 10.1109/JBHI.2024.3524085. \textbf{Đối thủ trực tiếp nhất ở cấu hình đơn kênh.}
\item Baldazzi G, Pani D. Open data: valuable resources and opportunities for the researchers in fetal
cardiac monitoring. Trong: \textit{Innovative Technologies and Signal Processing in Perinatal Medicine},
Springer, 2023. DOI 10.1007/978-3-031-32625-7\_12. \textbf{Đã nêu trước sự trùng lặp ADFECGDB
$\leftrightarrow$ bộ dữ liệu Matonia.}
\end{enumerate}

\begin{ghichu}[title={Vì sao bảy tài liệu bổ sung này quan trọng hơn bảy tài liệu thường}]
Sáu trong bảy tài liệu trên \textbf{làm yếu đi} một tuyên bố của nhóm, chứ không củng cố nó. Nhóm đưa
chúng vào đúng vì lý do đó: một phản biện Q1 tìm ra TCGAN hoặc Fotiadou 2021 mà thấy đề tài không trích
dẫn sẽ từ chối bài vì khảo sát y văn thiếu. Danh mục đầy đủ và phân tích từng bài ở
\texttt{survey/scout\_novelty.md}.
\end{ghichu}

