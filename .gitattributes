# Normalise line endings in the repository, check out native on each platform
* text=auto

*.py    text diff=python
*.tex   text
*.md    text
*.json  text
*.txt   text
*.cff   text
*.yml   text

# Binary
*.pt    binary
*.pdf   binary
*.docx  binary
*.png   binary
*.edf   binary

# Keep generated artefacts out of diffs and language statistics
de_cuong_latex/figs/*   linguist-generated=true
de_cuong_latex/tables/* linguist-generated=true
docs/*                  linguist-documentation=true
